# Copia este archivo como .env y rellena los valores localmente.
# Nunca subas .env al repositorio.

# Clave secreta de Flask para firmar la cookie de sesión.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Dominio institucional permitido para iniciar sesión (sin @).
ALLOWED_EMAIL_DOMAIN=

# Modo demostración desactivado por defecto. Usa true solo en desarrollo.
DEMO_MODE=

# Ruta opcional de la base SQLite de usuarios. Por defecto: users.db
USERS_DB=

# Minutos de bloqueo tras 5 intentos fallidos consecutivos.
LOCKOUT_MINUTES=

# Conexión de la base de datos analítica (opcional).
DATABASE_URL=
